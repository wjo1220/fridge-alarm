{
  "name": "fridge-alarm",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 알림 받는 사람 목록 저장소
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // 매일 한국 시간 아침 9시
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
